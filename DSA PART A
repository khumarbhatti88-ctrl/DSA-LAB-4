BookRequestNode* next;
};
class PriorityQueue
{
private:
BookRequestNode* front;
BookRequestNode* rear;
int count;
public:
PriorityQueue()
{
front = nullptr;
rear = nullptr;
count = 0;
}
void Add(BookRequestNode* request)
{
request-&gt;next = nullptr;
if (front == nullptr)
{
front = rear = request;
}

